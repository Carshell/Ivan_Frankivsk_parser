TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# false — повністю вимикає instagram-парсер (жодних звернень до Instagram),
# корисно як "аварійний вимикач", коли акаунт позначено як підозрілий
# (scraping_warning) і йому треба дати час "охолонути". За замовчуванням true.
INSTAGRAM_ENABLED=true
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# TOTP-секрет із налаштування 2FA через застосунок-автентифікатор — код
# підтвердження генерується автоматично (pyotp), вручну вводити не треба
INSTAGRAM_TOTP_SECRET=
# Заповнюй лише якщо звичайний логін падає з "Your version of Instagram is out
# of date" — див. коментар у instagram/login_instagram.py
INSTAGRAM_SESSIONID=
ANTHROPIC_API_KEY=
# Telegram chat_id адміна — сюди йдуть звіти після кожного циклу парсингу
# (що знайдено, що пройшло фільтри, чи були помилки). Дізнатись свій chat_id
# можна написавши боту @userinfobot.
ADMIN_CHAT_ID=
